{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "round-mouse-8bbd",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-17",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "FRONTEND_URL": "https://receitando.miguelpita.com.br,http://localhost:3000"
  },
  "d1_databases": [
    {
      "binding": "db",
      "database_name": "receitando",
      "database_id": "af1f7dbc-50a3-497c-9188-2f57467ae49b",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  }
}
