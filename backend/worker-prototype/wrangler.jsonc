{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Nome do serviço já publicado na Cloudflare. Mantido para preservar o Worker existente.
  "name": "round-mouse-8bbd",
  "main": "src/session-cookie-worker.ts",
  "compatibility_date": "2026-08-17",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "api.receitando.miguelpita.com.br",
      "custom_domain": true
    }
  ],
  "vars": {
    // Produção, endereço workers.dev e desenvolvimento local autorizados pelo CORS da API.
    "DATABASE_ENGINE": "postgres",
    "FRONTEND_URL": "https://receitando.miguelpita.com.br,https://www.receitando.miguelpita.com.br,https://receitando.miguellpitaa.workers.dev,http://localhost:3000",
    "EMAIL_FROM": "Receitando <noreply@mail.miguelpita.com.br>"
  },
  // Produção usa Neon via Hyperdrive; o banco D1 anterior foi excluído após a troca.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "f3d216f3a0cc4c81990b03bdca9b87ea"
    }
  ],
  "r2_buckets": [
    {
      "binding": "RECIPE_IMAGES",
      "bucket_name": "receitando-recipe-images"
    }
  ],
  "durable_objects": { "bindings": [{ "name": "COOKING_ROOMS", "class_name": "CookingRoom" }] },
  "migrations": [{ "tag": "cooking-room-v1", "new_sqlite_classes": ["CookingRoom"] }],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  }
}
