{
  "name": "receitando-backend-worker-prototype",
  "version": "0.1.0",
  "private": true,
  "description": "API do Receitando em Cloudflare Workers + D1",
  "scripts": {
    "cf-typegen": "wrangler types worker-configuration.d.ts --include-runtime false",
    "typecheck": "tsc --noEmit",
    "dev": "wrangler dev",
    "dry-run": "wrangler deploy --dry-run",
    "migrate:local": "wrangler d1 migrations apply recebendo --local",
    "migrate:remote": "wrangler d1 migrations apply recebendo --remote",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@prisma/adapter-pg": "6.19.3",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260813.1",
    "@types/express": "5.0.6",
    "@types/pg": "8.15.5",
    "typescript": "5.9.3",
    "wrangler": "4.122.0"
  },
  "engines": {
    "node": ">=20.9.0 <25"
  }
}
