{
  "name": "receitando-backend-worker-prototype",
  "version": "0.1.0",
  "private": true,
  "description": "API Receitando em Cloudflare Workers, Neon PostgreSQL via Hyperdrive",
  "scripts": {
    "cf-typegen": "wrangler types worker-configuration.d.ts --include-runtime false",
    "typecheck": "tsc --noEmit",
    "test:compile": "tsc -p tsconfig.tests.json",
    "test": "npm run test:compile && node --test tests/*.test.cjs",
    "dev": "wrangler dev",
    "dry-run": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "test:ws": "node scripts/test-cooking-rooms.mjs",
    "test:postgres": "npm run test:compile && node --test tests/postgres-adapter.test.cjs",
    "test:postgres:integration": "npm run test:compile && node scripts/test-postgres-schema.mjs",
    "import:references:dry-run": "node scripts/import-external-references.mjs",
    "import:references": "node scripts/import-external-references.mjs --apply"
  },
  "dependencies": {
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260823.1",
    "typescript": "5.9.3",
    "wrangler": "4.125.0",
    "@types/pg": "^8.15.5"
  },
  "engines": {
    "node": ">=20.9.0 <25"
  }
}
