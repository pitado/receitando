@startuml
title Receitando — Matching / REST stateless + Neon PostgreSQL
autonumber
actor "Usuário" as U
participant "Frontend /combinar" as F
participant "API REST catalog64-worker" as A
participant "recipe-utils" as N
participant "Cloudflare Hyperdrive" as H
database "Neon PostgreSQL 17" as PG
U -> F : Informa ingredientes ou usa despensa
alt Digitação
  F -> A : POST /api/recipes/match
else Despensa autenticada
  F -> A : GET /api/recipes/match/pantry
  A -> H : SELECT pantry_items WHERE user_id=?
  H -> PG : SQL parametrizado
  PG --> H : ingredient_id[]
  H --> A : IDs da despensa
end
A -> N : Normaliza nomes e aliases
N --> A : Formas canônicas
A -> H : SELECT ingredients, aliases, recipes,
recipe_ingredients
H -> PG : Consulta via pg/Hyperdrive
PG --> H : Linhas relacionais
H --> A : Resultados
A -> A : Ignorar opcionais/is_staple,
calcular encontrados e faltantes
A --> F : MatchRecipeResult[] em JSON
F --> U : Exibe compatibilidade e receitas
@enduml
