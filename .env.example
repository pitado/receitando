# PostgreSQL (usado pelo Docker Compose e pelo Prisma)
POSTGRES_USER=receitando
POSTGRES_PASSWORD=receitando
POSTGRES_DB=receitando
POSTGRES_PORT=5432
DATABASE_URL=postgresql://receitando:receitando@localhost:5432/receitando?schema=public

# Backend NestJS
PORT=3333
FRONTEND_URL=http://localhost:3000

# Frontend Next.js (variáveis NEXT_PUBLIC_* são expostas no navegador)
NEXT_PUBLIC_API_URL=http://localhost:3333
