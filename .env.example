# Configuração local atual do Receitando
#
# O frontend usa a API Worker local em http://localhost:8787.
# Copie esta variável para frontend/.env.local quando necessário.
NEXT_PUBLIC_API_URL=http://localhost:8787

# A API atual usa Cloudflare Worker + D1.
# Variáveis públicas da API ficam em backend/worker-prototype/wrangler.jsonc.
# Secrets reais NÃO devem ser salvos neste arquivo.
# Exemplo de secret usado em produção:
# RESEND_API_KEY=<configurar com wrangler/GitHub Secrets>

# Credenciais de deploy também ficam fora do repositório:
# CLOUDFLARE_API_TOKEN=<GitHub Secret>
# CLOUDFLARE_ACCOUNT_ID=<GitHub Secret>

# A configuração PostgreSQL/NestJS antiga pertence somente ao backend histórico
# documentado em backend/README.md.
